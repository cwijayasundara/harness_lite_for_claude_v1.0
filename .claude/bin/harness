#!/usr/bin/env node
// The one entrypoint. Hooks call it, the agent calls it, CI calls it — same code, same schema.
//
// Law 2: anything that decides what happens next is a script with an exit code. If you find
// yourself writing sequencing instructions into a SKILL.md, the logic belongs in here instead.

import { readFileSync, writeFileSync, mkdirSync, existsSync, cpSync, chmodSync } from 'node:fs';
import { execSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { loadConfig, VERBS } from '../lib/config.mjs';
import { layout, findRepoRoot } from '../lib/paths.mjs';
import { check, render } from '../lib/runner.mjs';
import * as ledger from '../lib/ledger.mjs';
import * as graph from '../lib/graph.mjs';
import * as baseline from '../lib/baseline.mjs';
import { pack, renderPack } from '../lib/pack.mjs';
import { refresh } from '../lib/refresh.mjs';
import { renderWiki } from '../lib/wiki.mjs';
import { measure, shipped, RECORD } from '../checks/budget.mjs';
import { dispatch } from '../hooks/dispatch.mjs';
import { lifecycle, incidents, renderLifecycle } from '../lib/lifecycle.mjs';
import { selectSlug, packet as reviewPacket, writeReview, checkProtection } from '../lib/review-adapter.mjs';
import { deploy, closeLoop, detect, readMonitorFile } from '../lib/operations.mjs';
import { applyHandoff } from '../lib/handoff.mjs';
import { playbookIndicators, renderPlaybook } from '../lib/indicators.mjs';
import { lockTests, clearLock, enterpriseChecklist } from '../lib/guard.mjs';
import { addWorktree } from '../lib/worktree.mjs';

const HERE = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const argv = process.argv.slice(2);
const cmd = argv[0];
const flag = (n, d = null) => { const i = argv.indexOf(`--${n}`); return i === -1 ? d : (argv[i + 1]?.startsWith('--') ? true : argv[i + 1] ?? true); };
const has = (n) => argv.includes(`--${n}`);

function changedFiles(root) {
  try {
    const tracked = execSync('git diff --name-only HEAD', { cwd: root, encoding: 'utf8' }).split('\n');
    const untracked = execSync('git ls-files --others --exclude-standard', { cwd: root, encoding: 'utf8' }).split('\n');
    return [...new Set([...tracked, ...untracked])].filter(Boolean).filter((f) => existsSync(path.join(root, f)));
  } catch { return []; }
}

const PERMISSIONS = { allow: [
  'Edit(.claude/artifacts/**)',
  'Bash(bash .claude/bin/harness:*)',
  'Bash(node .claude/bin/harness:*)',
  'Write(.claude/artifacts/**)',
] };

// The plugin identity, read from the two manifests rather than hardcoded. A rename that edits
// one manifest and not the other must fail the suite, not silently emit an id nobody publishes.
function pluginIdentity() {
  const plugin = JSON.parse(readFileSync(path.join(HERE, '.claude-plugin', 'plugin.json'), 'utf8'));
  return { name: plugin.name, version: plugin.version ?? '0.0.0', id: `${plugin.name}@${plugin.name}` };
}

// What a project commits. It declares which harness it uses and wires nothing: the five hook
// bindings arrive with the plugin, and declaring them here as well is what made each one fire
// twice for anyone who followed the README to the end.
function projectSettings(id) {
  return { enabledPlugins: { [id]: true }, permissions: PERMISSIONS };
}

// This repository is the harness *and* a project governed by it. It keeps its own wiring — an
// edit to a sensor must take effect on the next turn, not after a plugin reinstall — and
// explicitly disables the published plugin, or a maintainer who has it installed loads every
// guide twice and fires every binding twice. ${CLAUDE_PROJECT_DIR} keeps the commands portable:
// the absolute paths this used to emit were inert in every clone but the author's.
function selfSettings(id) {
  const registry = JSON.parse(readFileSync(path.join(HERE, 'hooks', 'hooks.json'), 'utf8'));
  const hooks = JSON.parse(JSON.stringify(registry.hooks).replaceAll('${CLAUDE_PLUGIN_ROOT}', '${CLAUDE_PROJECT_DIR}/.claude'));
  return { enabledPlugins: { [id]: false }, hooks, permissions: PERMISSIONS };
}

// The generated shim. It cannot import from the harness — locating the harness is its job — so
// the resolver is inline. Order matters: HARNESS_HOME first so CI can point at the clone it
// made from the recorded commit, then the plugin cache a laptop already has. Failure is loud
// and non-zero; a shim that silently resolved half a harness would reproduce the entire defect
// this change exists to end.
function shimSource() {
  return `#!/usr/bin/env bash
# generated by 'harness init' — do not edit by hand; re-run init to refresh.
# Resolves the harness this project declared, in the order: $HARNESS_HOME, then the plugin cache.
set -euo pipefail
here="$(cd "$(dirname "\${BASH_SOURCE[0]}")/.." && pwd)"
root="$(HARNESS_PROJECT_CLAUDE="$here" node -e '
const fs = require("node:fs"), path = require("node:path"), os = require("node:os");
const claude = process.env.HARNESS_PROJECT_CLAUDE;
if (process.env.HARNESS_HOME) { process.stdout.write(process.env.HARNESS_HOME); process.exit(0); }
let rec = {};
try { rec = JSON.parse(fs.readFileSync(path.join(claude, "harness-install.json"), "utf8")); } catch {}
const base = path.join(os.homedir(), ".claude", "plugins", "cache", rec.marketplace ?? "", rec.plugin ?? "");
for (const v of [rec.version, ...(fs.existsSync(base) ? fs.readdirSync(base).sort().reverse() : [])]) {
  if (v && fs.existsSync(path.join(base, v, "bin", "harness"))) { process.stdout.write(path.join(base, v)); process.exit(0); }
}
process.stderr.write("harness: not installed on this machine. Two one-time commands:\\n" +
  "  claude plugin marketplace add " + (rec.repository ?? "<repository>") + "\\n" +
  "  claude plugin install " + (rec.plugin ?? "<plugin>") + "@" + (rec.marketplace ?? "<marketplace>") + "\\n" +
  "Or set HARNESS_HOME to a checkout, which is what CI does.\\n");
process.exit(1);
')"
exec node "$root/bin/harness" "$@"
`;
}

// What the project installed, so CI can fetch exactly that and a human can say what they have.
// `unknown` rather than absent: a field the record could not fill must not read as an empty one,
// the same rule the budget applies to a surface it could not measure.
function harnessCommit() {
  try { return execSync('git rev-parse HEAD', { cwd: HERE, encoding: 'utf8' }).trim(); } catch { return 'unknown'; }
}

function harnessRepository() {
  try {
    return execSync('git remote get-url origin', { cwd: HERE, encoding: 'utf8' }).trim()
      .replace(/^.*github\.com[/:]/, '').replace(/\.git$/, '');
  } catch { return null; }
}

function validSlug(slug) {
  return typeof slug === 'string' && /^[a-z0-9](?:[a-z0-9-]{0,62})$/.test(slug);
}

function renderGraphAnswer(question, arg, answer) {
  if (!answer.length) {
    if (question === 'cycles' || question === 'hubs' || question === 'changed-since') return `none — graph query ${question} returned no entries`;
    return `no match for "${arg}". The graph is a cache, not an authority — fall back to: grep -rn "${arg}" .`;
  }
  return JSON.stringify(answer, null, 2);
}

async function main() {
  switch (cmd) {
    case 'init': {
      const root = path.resolve(flag('into', process.cwd()));
      const L = layout(root);
      for (const d of [L.claude, L.intent, L.spec, L.plan, L.review, L.incident, L.deployment, L.adr, L.state, path.join(L.claude, 'bin'), path.join(L.artifacts, 'design')]) mkdirSync(d, { recursive: true });
      for (const [src, dst] of [['templates/harness.toml', L.config], ['templates/CLAUDE.md', L.claudeMd], ['templates/gitignore', path.join(L.claude, '.gitignore')], ['templates/review-policy.md', path.join(L.claude, 'REVIEW.md')]]) {
        if (!existsSync(dst)) cpSync(path.join(HERE, src), dst);
      }
      // A project declares the harness; it never contains one. Copying the sensors in and
      // leaving the guides to a second, invisible install step is what produced projects that
      // ran every check with no guide loaded and no way to notice.
      const self = path.resolve(L.claude) === path.resolve(HERE);
      const identity = pluginIdentity();
      writeFileSync(path.join(L.claude, 'settings.json'),
        JSON.stringify(self ? selfSettings(identity.id) : projectSettings(identity.id), null, 2) + '\n');

      if (!self) {
        // The guides live in the plugin, so the project cannot count them and CI cannot fetch
        // them without being told where from. One committed record answers both, and pins the
        // exact commit so CI never drifts from the laptop that installed it.
        writeFileSync(path.join(L.claude, RECORD), JSON.stringify({
          note: `generated by 'harness init' — do not edit by hand; re-run init to refresh`,
          marketplace: identity.name,
          plugin: identity.name,
          version: identity.version,
          commit: harnessCommit(),
          repository: harnessRepository(),
          shipped: shipped(HERE),
        }, null, 2) + '\n');
        const shim = path.join(L.claude, 'bin', 'harness');
        writeFileSync(shim, shimSource());
        chmodSync(shim, 0o755);
      }
      const how = self ? 'node .claude/bin/harness' : 'bash .claude/bin/harness';
      console.log(`initialised .claude/ in ${root}\n  1. edit .claude/harness.toml — 8 capability verbs, one line each\n  2. ${how} doctor\n  3. ${how} baseline capture\n  the guides come from the ${identity.id} plugin — see README step 6, once per machine`);
      return 0;
    }

    case 'doctor': {
      const cfg = loadConfig(findRepoRoot());
      console.log(`project   ${cfg.project.name ?? '(unnamed)'}\nroot      ${cfg.layout.root}\n`);
      for (const v of VERBS) {
        const c = cfg.capabilities[v];
        const fmt = cfg.formats[v] ?? 'generic';
        const builtin = v === 'secrets' && !c;
        console.log(`  ${c || builtin ? 'set ' : '--  '} ${v.padEnd(10)} ${c ? `[${fmt}] ${c}` : builtin ? '[built-in] secret scanner' : '(skipped — no command)'}`);
      }
      const m = measure(cfg);
      // `?`, never `0`: a surface the budget could not account for must not read as an empty one.
      console.log(`\nbudget    ${Object.entries(m).map(([k, v]) => `${k}=${v ?? '?'}/${cfg.limits[k] ?? '-'}`).join('  ')}`);
      const market = path.join(cfg.layout.root, '.claude-plugin/marketplace.json');
      if (existsSync(market)) {
        try {
          const plugins = JSON.parse(readFileSync(market, 'utf8')).plugins ?? [];
          console.log(`plugins   ${plugins.map((p) => p.name).join(', ') || '(none)'}`);
        } catch { /* marketplace is advisory */ }
      }
      if (has('enterprise')) {
        console.log('\nenterprise checklist (git settings are not managed settings)');
        for (const item of enterpriseChecklist(cfg)) {
          console.log(`  ${item.ok ? 'ok  ' : 'need'}  ${item.id}  ${item.detail}`);
        }
      }
      return 0;
    }

    case 'check': {
      const cfg = loadConfig(findRepoRoot());
      const stage = flag('stage', 'fast');
      const files = has('changed') ? changedFiles(cfg.layout.root) : (flag('files') && typeof flag('files') === 'string' ? String(flag('files')).split(',') : []);
      const report = await check(cfg, { stage, files, all: has('all') });
      if (has('json')) console.log(JSON.stringify(report, null, 2));
      else console.log(render(report, cfg.layout));
      return report.ok ? 0 : 1;
    }

    case 'ledger': {
      const L = layout(findRepoRoot());
      const days = Number(flag('days', 30));
      if (argv[1] === 'audit') {
        const a = ledger.audit(L, { days });
        console.log(`ledger audit · ${a.rows} rows · ${a.runs} runs · last ${a.days}d`);
        console.log(`thresholds: fires on >=${a.thresholds.min_fire_rate * 100}% of invocations, errors on <${a.thresholds.max_error_rate * 100}%, after ${a.thresholds.min_sessions} invocations\n`);
        for (const c of a.controls) console.log(`  ${c.control.padEnd(16)} ${String(c.invocations).padStart(3)} inv  ${(c.fire_rate * 100).toFixed(1).padStart(5)}% fired  ${c.action}`);
        console.log(a.deletions.length ? `\nDelete candidates: ${a.deletions.join(', ')}` : '\nNothing to delete this month. Some controls still lack the invocations for an honest verdict.');
        return 0;
      }
      const r = ledger.report(L, { days });
      if (has('json')) { console.log(JSON.stringify(r, null, 2)); return 0; }
      console.log(`ledger  ${r.rows} rows  ${r.runs} runs  last ${r.days}d\n`);
      console.log('  control      invocations  fired   fire%   errs  avg-ms  verdict');
      for (const c of r.controls) console.log(`  ${c.control.padEnd(12)} ${String(c.invocations).padStart(11)} ${String(c.fired).padStart(6)} ${(c.fire_rate * 100).toFixed(1).padStart(7)} ${String(c.errored).padStart(6)} ${String(c.avg_ms).padStart(7)}  ${c.verdict}`);
      return 0;
    }

    case 'baseline': {
      const cfg = loadConfig(findRepoRoot());
      const sub = argv[1];
      const now = await baseline.capture(cfg);
      if (sub === 'capture') { console.log(`baseline captured: ${baseline.save(cfg, now)}`); return 0; }
      if (sub !== 'check') { console.error('usage: harness baseline capture|check'); return 2; }
      const base = baseline.load(cfg);
      if (!base) { console.error('no baseline — run: harness baseline capture'); return 2; }
      const result = baseline.compare(base, now);
      for (const r of result.rows) console.log(`${r.regressed ? 'FAIL' : r.skipped ? 'SKIP' : 'PASS'}  ${r.metric.padEnd(24)} ${r.was} -> ${r.is}${r.skipped ? `  (${r.skipped})` : ''}`);
      return result.ok ? 0 : 1;
    }

    case 'graph': {
      const cfg = loadConfig(findRepoRoot());
      const sub = argv[1];
      if (sub === 'build') { const g = graph.build(cfg); graph.save(cfg, g); renderWiki(cfg, g); console.log(`graph built: ${Object.keys(g.modules).length} modules`); return 0; }
      if (sub === 'refresh') { console.log(JSON.stringify(refresh(cfg, { force: has('force') }), null, 2)); return 0; }
      if (sub === 'query') {
        const question = argv[2]; const arg = argv[3];
        const g = graph.ensure(cfg);
        console.log(renderGraphAnswer(question, arg, graph.query(g, question, arg, { root: cfg.layout.root })));
        return 0;
      }
      console.error('usage: harness graph build|refresh|query <callers|calls|hubs|cycles|changed-since> [arg]'); return 2;
    }

    case 'wiki': {
      const cfg = loadConfig(findRepoRoot());
      const r = renderWiki(cfg, graph.ensure(cfg));
      console.log(`wiki rendered: ${r.pages} pages in ${r.dir}`); return 0;
    }

    case 'pack': {
      const cfg = loadConfig(findRepoRoot());
      const question = argv.slice(1).filter((x) => x !== '--budget' && x !== String(flag('budget'))).join(' ');
      console.log(renderPack(pack(cfg, graph.ensure(cfg), question, { budget: Number(flag('budget', 1200)) })));
      return 0;
    }

    case 'new': {
      const kind = argv[1]; const slug = argv[2];
      if (!['intent', 'spec', 'plan', 'review', 'incident', 'eval'].includes(kind) || !slug) { console.error('usage: harness new intent|spec|plan|review|incident|eval <slug>'); return 2; }
      if (!validSlug(slug)) { console.error('slug must be 1–63 lowercase letters, digits, or hyphens; it cannot contain paths'); return 2; }
      const cfg = loadConfig(findRepoRoot());
      if (kind === 'eval') {
        const dir = path.join(cfg.layout.claude, 'evals', 'pending'); mkdirSync(dir, { recursive: true });
        const dst = path.join(dir, `${slug}.json`);
        if (existsSync(dst)) { console.log(dst); return 0; }
        writeFileSync(dst, JSON.stringify({ id: slug, fixture: 'clean-app', prompt: `Regression for incident ${slug}. Reproduce, then keep the suite green without editing the failing test.`, assert: [{ fixture_tests_pass: true }, { files_unchanged: ['README.md'] }] }, null, 2) + '\n');
        console.log(dst); return 0;
      }
      const dir = cfg.layout[kind]; mkdirSync(dir, { recursive: true });
      const dst = path.join(dir, `${slug}.md`);
      if (existsSync(dst)) { console.log(dst); return 0; }
      const now = new Date();
      const tpl = readFileSync(path.join(HERE, 'templates', `${kind}.md`), 'utf8').replaceAll('{{slug}}', slug).replaceAll('{{date}}', now.toISOString().slice(0, 10)).replaceAll('{{timestamp}}', now.toISOString());
      writeFileSync(dst, tpl); console.log(dst); return 0;
    }

    case 'lock': {
      const cfg = loadConfig(findRepoRoot());
      if (argv[1] === 'clear') { console.log(clearLock(cfg)); return 0; }
      if (argv[1] !== 'tests') { console.error('usage: harness lock tests [--pattern tests/] [--why "bug fix in progress"]\n       harness lock clear'); return 2; }
      const pattern = typeof flag('pattern') === 'string' ? flag('pattern') : 'tests';
      const why = typeof flag('why') === 'string' ? flag('why') : 'bug fix in progress';
      console.log(lockTests(cfg, { patterns: [pattern], why })); return 0;
    }

    case 'worktree': {
      const slug = argv[1];
      if (!validSlug(slug)) { console.error('usage: harness worktree <slug>'); return 2; }
      const cfg = loadConfig(findRepoRoot());
      const result = addWorktree(cfg.layout.root, slug);
      console.log(`${result.branch}\n${result.dest}`); return 0;
    }

    case 'status': {
      const cfg = loadConfig(findRepoRoot());
      const rows = lifecycle(cfg, argv[1] && !argv[1].startsWith('--') ? argv[1] : null);
      const incidentRows = argv[1] && !argv[1].startsWith('--') ? [] : incidents(cfg);
      const playbook = playbookIndicators(cfg, lifecycle(cfg));
      console.log(has('json') ? JSON.stringify({ changes: rows, incidents: incidentRows, playbook }, null, 2) : renderLifecycle(rows, incidentRows) + renderPlaybook(playbook));
      return [...rows, ...incidentRows].some((r) => !r.valid || r.sla === 'breached') ? 1 : 0;
    }

    case 'handoff': {
      const cfg = loadConfig(findRepoRoot());
      const result = applyHandoff(cfg, { templateDir: path.join(HERE, 'templates'), write: has('write') });
      if (has('json')) console.log(JSON.stringify(result, null, 2));
      else if (!result.actions.length) console.log('handoff  nothing to do');
      else for (const a of result.actions) console.log(`handoff  ${a.slug}: ${a.from} -> ${a.to}${result.created.some((c) => c.slug === a.slug && c.kind === a.to) ? '  wrote' : ''}`);
      return 0;
    }

    case 'review': {
      const cfg = loadConfig(findRepoRoot()); const sub = argv[1];
      if ((sub === 'select' || sub === 'packet') && !flag('base')) { console.error('review requires --base <git-ref>'); return 2; }
      if (sub === 'select') { console.log(selectSlug(cfg.layout.root, String(flag('base')), String(flag('head', 'HEAD')))); return 0; }
      if (sub === 'packet') { const slug = argv[2]; if (!validSlug(slug)) { console.error('invalid review slug'); return 2; } console.log(reviewPacket(cfg, slug, String(flag('base')), String(flag('head', 'HEAD')))); return 0; }
      if (sub === 'ingest') {
        const slug = argv[2]; if (!validSlug(slug)) { console.error('invalid review slug'); return 2; }
        const file = flag('file'); const raw = file ? readFileSync(path.resolve(String(file)), 'utf8') : process.env.HARNESS_REVIEW_JSON;
        if (!raw) { console.error('review JSON required via --file or HARNESS_REVIEW_JSON'); return 2; }
        const result = writeReview(cfg, slug, JSON.parse(raw), { reviewer: process.env.GITHUB_ACTOR, commit: process.env.GITHUB_SHA, pull_request: process.env.HARNESS_PULL_REQUEST });
        console.log(result.file); return result.recommendation === 'approve' ? 0 : 1;
      }
      console.error('usage: harness review select|packet|ingest'); return 2;
    }

    case 'github': {
      if (argv[1] !== 'protection-check' || !flag('file')) { console.error('usage: harness github protection-check --file protection.json [--required-check harness]'); return 2; }
      const value = JSON.parse(readFileSync(path.resolve(String(flag('file'))), 'utf8')); const result = checkProtection(value, String(flag('required-check', 'harness')));
      if (has('json')) console.log(JSON.stringify(result, null, 2)); else console.log(result.ok ? 'branch protection: PASS' : `branch protection: FAIL\n${result.failures.map((f) => `  - ${f}`).join('\n')}`);
      return result.ok ? 0 : 1;
    }

    case 'deploy': {
      const cfg = loadConfig(findRepoRoot()); const operation = argv[1]; const environment = argv[2];
      if (!operation || !environment) { console.error('usage: harness deploy <deploy|status|rollback> <environment> [--approval ID]'); return 2; }
      const result = deploy(cfg, operation, environment, { approval: flag('approval') });
      console.log(`${result.ok ? 'PASS' : 'FAIL'}  ${operation} ${environment}\nreceipt  ${result.file}`);
      return result.ok ? 0 : 1;
    }

    case 'monitor': {
      const cfg = loadConfig(findRepoRoot());
      if (argv[1] === 'ingest') {
        if (!argv[2] || !flag('file')) { console.error('usage: harness monitor ingest <slug> --file bands.json'); return 2; }
        const result = closeLoop(cfg, argv[2], readMonitorFile(path.resolve(String(flag('file')))));
        console.log(result.breached ? `BREACH  ${result.breaches.length} control band(s)\n${result.files.join('\n')}` : 'PASS  all control bands within range');
        return 0;
      }
      if (argv[1] !== 'detect') { console.error('usage: harness monitor detect [slug] [--file bands.json] [--json]\n       harness monitor ingest <slug> --file bands.json'); return 2; }
      const slug = argv[2] && !String(argv[2]).startsWith('--') ? argv[2] : null;
      const result = detect(cfg, { file: flag('file') ? path.resolve(String(flag('file'))) : null, slug });
      if (has('json')) console.log(JSON.stringify(result, null, 2));
      else if (!result.configured) console.log('monitor  not configured');
      else if (result.already_open) console.log('OPEN  incident already recorded');
      else if (result.breached) {
        const rb = result.rolled_back ? `\nrollback  staging  ${result.rollback?.file ?? 'ok'}` : (result.tier >= 3 ? '\nrollback  skipped' : '');
        console.log(`BREACH  ${result.breaches.length} control band(s)\n${result.files.join('\n')}${rb}`);
      }
      else console.log('PASS  all control bands within range');
      return 0;
    }

    case 'hook': return dispatch(argv[1]);

    default:
      console.log(`harness — the lean SDLC harness

  harness init [--into DIR]        create .claude/ with harness.toml + CLAUDE.md
  harness doctor [--enterprise]    capability verbs, budget, enterprise checklist
  harness check --stage <s>        run a stage   (--changed  --all  --json)
  harness new intent|spec|plan|review|incident|eval <slug>
  harness lock tests [--pattern p] [--why text]
  harness lock clear
  harness worktree <slug>          git worktree for an independent plan slice
  harness handoff [--write] [--json]
  harness status [slug] [--json]  artifact progress, SLA, playbook indicators
  harness review select|packet|ingest
  harness github protection-check --file protection.json
  harness deploy <deploy|status|rollback> <environment> [--approval ID]
  harness monitor detect [slug] [--file bands.json]
  harness monitor ingest <slug> --file bands.json
  harness ledger [audit] [--days 30]
  harness baseline capture|check
  harness graph build|refresh|query <question> [arg]
  harness wiki                     render the codebase map
  harness pack <question>          budgeted graph context
  harness hook <event>             hook dispatch (stdin/stdout JSON)`);
      return cmd ? 2 : 0;
  }
}

main().then((c) => process.exit(c ?? 0)).catch((e) => {
  if (e.code === 'ENOCONFIG') { console.error(e.message); process.exit(2); }
  console.error(`harness: ${e.message}`);
  process.exit(2);
});
