{
  "_comment": "Copy into the Claude admin console or MDM. Do not treat a git-committed settings.json as managed. Engineers can edit git files; they cannot edit managed settings.",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(./secrets/**)",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(node .claude/bin/harness *)",
      "Bash(bash .claude/bin/harness *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  },
  "allowManagedHooksOnly": true,
  "disableSideloadFlags": true
}
