{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.work-item-snapshot/v1",
  "type": "object",
  "required": ["schema", "change_id", "source", "snapshot_digest", "captured_at", "intent"],
  "properties": {
    "schema": { "const": "aidlc.work-item-snapshot/v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "source": { "type": "object", "required": ["provider", "locator", "revision"], "properties": { "provider": { "const": "jira" }, "locator": { "type": "string" }, "revision": { "type": "string" } }, "additionalProperties": false },
    "snapshot_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "intent": { "type": "object", "required": ["provider", "locator", "title", "description", "project", "issue_type"] }
  },
  "additionalProperties": false
}
