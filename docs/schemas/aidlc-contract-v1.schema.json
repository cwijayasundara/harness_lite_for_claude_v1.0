{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.contract/v1",
  "description": "Markdown contract validated by the harness; this schema documents its metadata projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change_id", "intent_ref", "risk", "spec_status", "spec_approval_digest", "plan_status", "plan_approval_digest"],
  "properties": {
    "schema": { "const": "aidlc.contract/v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "intent_ref": { "type": "string", "minLength": 1 },
    "story_ref": { "type": ["string", "null"] },
    "risk": { "enum": ["low", "standard", "critical"] },
    "spec_status": { "enum": ["draft", "approved"] },
    "spec_approval_digest": { "type": "string", "pattern": "^(pending|sha256:[a-f0-9]{64})$" },
    "plan_status": { "enum": ["draft", "approved"] },
    "plan_approval_digest": { "type": "string", "pattern": "^(pending|sha256:[a-f0-9]{64})$" }
  }
}
