{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.prompt-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change_id", "contract_digest", "role", "provider", "model_resolution", "renderer", "prompt_digest", "prompt"],
  "properties": {
    "schema": { "const": "aidlc.prompt-manifest/v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "role": { "enum": ["execute", "evaluate"] },
    "provider": { "type": "string", "minLength": 1 },
    "model_resolution": { "type": "object" },
    "renderer": { "const": "aidlc.prompt/v1" },
    "prompt_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "prompt": { "type": "string", "minLength": 1 }
  }
}
