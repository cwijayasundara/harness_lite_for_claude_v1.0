{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.evaluation/v1",
  "type": "object",
  "required": ["schema", "change_id", "contract_digest", "git_commit", "evaluator_invocation_id", "recommendation", "findings"],
  "properties": {
    "schema": { "const": "aidlc.evaluation/v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "evaluator_invocation_id": { "type": "string", "minLength": 1 },
    "recommendation": { "enum": ["approve", "changes-requested"] },
    "findings": { "type": "array", "maxItems": 50 }
  },
  "additionalProperties": false
}
