{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.sensor-run/v1",
  "type": "object",
  "required": ["schema", "generated_at", "project", "changed_files", "latency_budget_ms", "ms", "latency_ok", "profiles", "ok"],
  "properties": {
    "schema": { "const": "aidlc.sensor-run/v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project": { "type": ["string", "null"] },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "latency_budget_ms": { "type": "number", "exclusiveMinimum": 0 },
    "ms": { "type": "number", "minimum": 0 },
    "latency_ok": { "type": "boolean" },
    "profiles": { "type": "array", "items": { "type": "object", "required": ["profile", "verdict", "ms", "controls"] } },
    "ok": { "type": "boolean" }
  },
  "additionalProperties": false
}
