{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change_id", "contract_digest", "generated_at", "capabilities", "behaviours", "review"],
  "properties": {
    "schema": { "const": "aidlc.evidence/v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capabilities": { "type": "object" },
    "behaviours": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "evidence"],
        "properties": {
          "status": { "enum": ["pending", "pass", "fail", "blocked"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "enum": ["pending", "approved", "changes-requested"] } },
      "additionalProperties": true
    }
  }
}
