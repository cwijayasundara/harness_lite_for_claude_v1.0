{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.deployment-receipt/v1",
  "type": "object",
  "required": ["schema", "receipt_id", "operation", "environment", "source_environment", "artifact_digest", "risk", "approval", "approvals", "timestamp", "status", "command", "exit_code", "signal", "stdout", "stderr", "verification_receipt"],
  "properties": {
    "schema": { "const": "aidlc.deployment-receipt/v1" },
    "receipt_id": { "type": "string", "format": "uuid" },
    "operation": { "enum": ["preflight", "deploy", "status", "verify", "promote", "rollback"] },
    "environment": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$" },
    "source_environment": { "type": ["string", "null"] },
    "artifact_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "risk": { "enum": ["low", "standard", "critical"] },
    "approval": { "type": ["string", "null"] },
    "approvals": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "enum": ["succeeded", "failed", "timed-out", "denied"] },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exit_code": { "type": ["integer", "null"] },
    "signal": { "type": ["string", "null"] },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" },
    "verification_receipt": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
