{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.work-item-receipt/v1",
  "type": "object",
  "required": ["schema", "receipt_id", "operation", "operation_key", "provider", "status", "created_at"],
  "properties": {
    "schema": { "const": "aidlc.work-item-receipt/v1" },
    "receipt_id": { "type": "string", "format": "uuid" },
    "operation": { "enum": ["resolve", "snapshot", "verify", "create", "transition", "link_commit", "link_contract", "link_pr", "comment"] },
    "operation_key": { "type": "string", "minLength": 1 },
    "provider": { "const": "jira" },
    "status": { "enum": ["succeeded", "failed", "denied", "drifted"] },
    "created_at": { "type": "string", "format": "date-time" },
    "change_id": { "type": "string" },
    "locator": { "type": "string" },
    "replayed": { "type": "boolean" },
    "actor": { "type": "string" },
    "actor_kind": { "enum": ["human", "agent"] },
    "target": { "type": "string" },
    "url": { "type": "string" },
    "global_id": { "type": "string" },
    "id": { "type": "string" },
    "error": { "type": "string" }
  },
  "additionalProperties": false
}
