{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.handoff/v1",
  "type": "object",
  "required": ["schema", "change_id", "contract_file", "contract_digest", "git_commit", "from_role", "to_role", "source_invocation_id", "target", "attempt", "max_attempts", "created_at"],
  "properties": {
    "schema": { "const": "aidlc.handoff/v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "contract_file": { "type": "string", "minLength": 1 },
    "contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "git_commit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "from_role": { "enum": ["specify", "generate", "evaluate", "diagnose"] },
    "to_role": { "enum": ["specify", "generate", "evaluate", "diagnose"] },
    "source_invocation_id": { "type": "string", "minLength": 1 },
    "target": { "type": "object" },
    "attempt": { "type": "integer", "minimum": 1 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
