{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.model-policy/v1",
  "type": "object",
  "required": ["schema", "revision", "roles", "policies", "max_repair_loops"],
  "properties": {
    "schema": { "const": "aidlc.model-policy/v1" },
    "revision": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "required": ["specify", "generate", "evaluate", "diagnose"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "policies": { "type": "object", "minProperties": 1 },
    "max_repair_loops": { "type": "integer", "minimum": 0, "maximum": 10 }
  },
  "additionalProperties": false
}
