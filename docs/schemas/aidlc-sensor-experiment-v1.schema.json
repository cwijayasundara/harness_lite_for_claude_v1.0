{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.sensor-experiment/v1",
  "type": "object",
  "required": ["schema", "latency_budget_ms", "baselines", "cases"],
  "properties": {
    "schema": { "const": "aidlc.sensor-experiment/v1" },
    "latency_budget_ms": { "type": "number", "exclusiveMinimum": 0 },
    "baselines": { "type": "array", "items": { "$ref": "#/$defs/baseline" } },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "stack": { "enum": ["python", "typescript", "jvm"] },
    "profile": { "enum": ["behaviour", "architecture", "hardening", "qa"] },
    "baseline": {
      "type": "object", "required": ["stack", "ok", "latency_ms"],
      "properties": { "stack": { "$ref": "#/$defs/stack" }, "ok": { "const": true }, "latency_ms": { "type": "number", "minimum": 0 } },
      "additionalProperties": false
    },
    "case": {
      "type": "object", "required": ["stack", "defect", "detected_by", "latency_ms"],
      "properties": {
        "stack": { "$ref": "#/$defs/stack" },
        "defect": { "enum": ["do-nothing", "test-cheating", "boundary-breaking", "security-defective"] },
        "detected_by": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/profile" } },
        "latency_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
