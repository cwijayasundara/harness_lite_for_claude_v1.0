{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidlc.model-run/v1",
  "type": "object",
  "required": ["schema", "role", "provider", "model", "policy_digest", "invocation_id", "status", "duration_ms", "cost_usd", "exit_code", "output_digest"],
  "properties": {
    "schema": { "const": "aidlc.model-run/v1" },
    "role": { "enum": ["specify", "generate", "evaluate", "diagnose"] },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "policy_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "invocation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["succeeded", "outage", "timeout", "budget-exceeded", "failed"] },
    "duration_ms": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "exit_code": { "type": "integer" },
    "output_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
