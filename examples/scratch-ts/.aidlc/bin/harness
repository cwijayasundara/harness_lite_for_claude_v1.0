#!/usr/bin/env bash
# generated by 'harness init' — do not edit by hand; re-run init to refresh.
# Resolves the harness this project declared, in the order: $HARNESS_HOME, then the plugin cache.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$(HARNESS_PROJECT_AIDLC="$here" node -e '
const fs = require("node:fs"), path = require("node:path"), os = require("node:os");
const aidlc = process.env.HARNESS_PROJECT_AIDLC;
// A candidate is only a harness if it actually holds one. Accepting HARNESS_HOME unchecked
// turned a mistyped CI variable into a node module stack trace instead of the two commands
// that fix it, which is the silent-ish failure this shim exists to prevent.
const runtime = (d) => !d ? null : fs.existsSync(path.join(d, "bin", "harness")) ? d : fs.existsSync(path.join(d, ".aidlc", "bin", "harness")) ? path.join(d, ".aidlc") : null;
let rec = {};
try { rec = JSON.parse(fs.readFileSync(path.join(aidlc, "harness-install.json"), "utf8")); } catch {}
const home = process.env.HARNESS_HOME;
if (runtime(home)) { process.stdout.write(runtime(home)); process.exit(0); }
const base = path.join(os.homedir(), ".claude", "plugins", "cache", rec.marketplace ?? "", rec.plugin ?? "");
for (const v of [rec.version, ...(fs.existsSync(base) ? fs.readdirSync(base).sort().reverse() : [])]) {
  const found = v && runtime(path.join(base, v));
  if (found) { process.stdout.write(found); process.exit(0); }
}
process.stderr.write((home ? "harness: HARNESS_HOME=" + home + " holds no .aidlc/bin/harness.\n" : "") +
  "harness: not installed on this machine. Two one-time commands:\n" +
  "  claude plugin marketplace add " + (rec.repository ?? "<repository>") + "\n" +
  "  claude plugin install " + (rec.plugin ?? "<plugin>") + "@" + (rec.marketplace ?? "<marketplace>") + "\n" +
  "Or set HARNESS_HOME to a checkout, which is what CI does.\n");
process.exit(1);
')"
exec node "$runtime/bin/harness" "$@"
