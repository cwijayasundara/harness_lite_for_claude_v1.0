#!/usr/bin/env node
// The one entrypoint. Hooks call it, the agent calls it, CI calls it — same code, same schema.
//
// Law 2: anything that decides what happens next is a script with an exit code. If you find
// yourself writing sequencing instructions into a SKILL.md, the logic belongs in here instead.

import { RUNTIME_PATHS, installationIdentity, runtimeIdentity, policyIdentity, shimVerifierSource } from '../lib/runtime-identity.mjs';
import { productContext, renderProduct, revisionPack, renderRevisionPack } from '../lib/product-context.mjs';
import { coordination, coordinationLines } from '../lib/coordination.mjs';
import { readFileSync, writeFileSync, mkdirSync, existsSync, cpSync, chmodSync, readdirSync, rmSync } from 'node:fs';
import { execSync, spawnSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { loadConfig, VERBS } from '../lib/config.mjs';
import { layout, findRepoRoot } from '../lib/paths.mjs';
import { check, render } from '../lib/runner.mjs';
import * as ledger from '../lib/ledger.mjs';
import * as graph from '../lib/graph.mjs';
import * as baseline from '../lib/baseline.mjs';
import { pack, renderPack } from '../lib/pack.mjs';
import { refresh } from '../lib/refresh.mjs';
import * as codemap from '../lib/map.mjs';
import { measure, shipped, RECORD } from '../checks/budget.mjs';
import { dispatch } from '../hooks/dispatch.mjs';
import { review, hostReview } from '../lib/review.mjs';
import * as prReview from '../lib/pr-review.mjs';
import * as release from '../lib/release.mjs';
import { metrics, render as renderMetrics } from '../lib/metrics.mjs';
import { collisions, collisionLines } from '../lib/agent-collisions.mjs';
import { deliver, deliverInvoker, ghPullRequest, readState, PHASES } from '../lib/deliver.mjs';
import { changedFiles as diffFiles, prChange } from '../lib/diff.mjs';
import * as evalGate from '../lib/eval-gate.mjs';

const gitHead = (root) => { try { return execSync('git rev-parse HEAD', { cwd: root, encoding: 'utf8' }).trim(); } catch { return null; } };
import * as artifacts from '../lib/artifacts.mjs';
import * as intake from '../lib/intake.mjs';
import { renderClaudeInstructions, renderModel, composeProjectInstructions, ignoreFileAdditions, GENERATED_PATHS } from '../lib/projection.mjs';
import { detect, applyDetection, detectionReport } from '../lib/toolchain.mjs';

const HERE = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const PLUGIN_ROOT = path.dirname(HERE);
const argv = process.argv.slice(2);
const cmd = argv[0];
const flag = (n, d = null) => { const i = argv.indexOf(`--${n}`); return i === -1 ? d : (argv[i + 1]?.startsWith('--') ? true : argv[i + 1] ?? true); };
const has = (n) => argv.includes(`--${n}`);

function contextOptions(args, packing = false) {
  const opts = {};
  for (let i = 0; i < args.length; i++) {
    const name = args[i].replace(/^--/, '');
    if (!args[i].startsWith('--') || !['revision', 'records', 'json', ...(packing ? ['budget'] : [])].includes(name) || Object.hasOwn(opts, name)) throw new Error('invalid or duplicate context option');
    if (name === 'json') opts.json = true;
    else {
      const value = args[++i];
      if (!value || value.startsWith('--')) throw new Error(`--${name} requires a value`);
      opts[name] = name === 'budget' ? Number(value) : value;
    }
  }
  if (!opts.revision) throw new Error('context requires --revision <commit>');
  return opts;
}

function changedFiles(root) {
  return diffFiles({ layout: { root } });
}

const PERMISSIONS = { allow: [
  'Edit(.aidlc/artifacts/**)',
  'Bash(.aidlc/bin/harness:*)',
  'Bash(node .aidlc/bin/harness:*)',
  'Write(.aidlc/artifacts/**)',
] };

// The plugin identity, read from the two manifests rather than hardcoded. A rename that edits
// one manifest and not the other must fail the suite, not silently emit an id nobody publishes.
function pluginIdentity() {
  const plugin = JSON.parse(readFileSync(path.join(PLUGIN_ROOT, '.claude-plugin', 'plugin.json'), 'utf8'));
  return { name: plugin.name, version: plugin.version ?? '0.0.0', id: `${plugin.name}@${plugin.name}` };
}

// What a project commits. It declares which harness it uses and wires nothing: the five hook
// bindings arrive with the plugin, and declaring them here as well is what made each one fire
// twice for anyone who followed the README to the end.
function projectSettings(id) {
  return { enabledPlugins: { [id]: true }, permissions: PERMISSIONS };
}

// This repository builds the harness, so activating the harness here creates a recursive control
// loop: its Stop hook runs the suite that is currently changing the Stop hook. Disable both ways
// it could activate (the installed plugin and project-local hook wiring). Consumers still enable
// the plugin through projectSettings().
function selfSettings(id) {
  return { enabledPlugins: { [id]: false }, permissions: PERMISSIONS };
}

// Claude always loads a repository's CLAUDE.md, independently of plugins and hooks. Projecting
// the consumer workflow into the harness source repo therefore activates the harness through
// instructions even when settings correctly disable it. Keep the canonical consumer guidance
// under .aidlc/, but give maintainers a small, unambiguous non-activating projection.
function selfInstructions() {
  return `<!-- Generated for the harness source repository; edit .aidlc/instructions.md for consumer guidance. -->
# lean-harness source

This repository builds the Claude Code harness. Do not activate or invoke the harness workflow
while working here: do not create \`.aidlc/artifacts/\`, run \`harness new\`, resume AIDLC stages,
or treat the consumer instructions in \`.aidlc/instructions.md\` as repository instructions.

The harness plugin and all project-local harness hooks must remain disabled in this repository.
Use ordinary repository development and run relevant tests directly with \`node --test\`.
`;
}

// The generated shim. It cannot import from the harness — locating the harness is its job — so
// the resolver is inline. Order matters: HARNESS_HOME first so CI can point at the clone it
// made from the recorded commit, then the plugin cache a laptop already has. Failure is loud
// and non-zero; a shim that silently resolved half a harness would reproduce the entire defect
// this change exists to end.
function shimSource() {
  const quote = value => "'" + value.replaceAll("'", "'\\''") + "'";
  return `#!/usr/bin/env bash
# generated by harness init; checks pinned content before executing the runtime.
set -euo pipefail
here="$(cd "$(dirname "\${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$(HARNESS_PROJECT_AIDLC="$here" node -e ${quote(shimVerifierSource())})"
exec node "$runtime/bin/harness" "$@"
`;

}
// What the project installed, so CI can fetch exactly that and a human can say what they have.
// `unknown` rather than absent: a field the record could not fill must not read as an empty one,
// the same rule the budget applies to a surface it could not measure.
function harnessCommit() {
  try { return execSync('git rev-parse HEAD', { cwd: PLUGIN_ROOT, encoding: 'utf8' }).trim(); } catch { return 'unknown'; }
}

function harnessRepository() {
  try {
    return execSync('git remote get-url origin', { cwd: PLUGIN_ROOT, encoding: 'utf8' }).trim()
      .replace(/^.*github\.com[/:]/, '').replace(/\.git$/, '');
  } catch { return null; }
}

function validSlug(slug) {
  return typeof slug === 'string' && /^[a-z0-9](?:[a-z0-9-]{0,62})$/.test(slug);
}

function renderGraphAnswer(question, arg, answer) {
  if (!answer.length) {
    if (question === 'cycles' || question === 'hubs' || question === 'changed-since') return `none — graph query ${question} returned no entries`;
    return `no match for "${arg}". The graph is a cache, not an authority — fall back to: grep -rn "${arg}" .`;
  }
  return JSON.stringify(answer, null, 2);
}

async function main() {
  switch (cmd) {
    case 'init': {
      const root = path.resolve(flag('into', process.cwd()));
      const L = layout(root);
      const self = path.resolve(L.aidlc) === path.resolve(HERE);
      // Whether this project already had a registry before this invocation: a fresh one is filled
      // from detection, an existing one is only ever reported on unless `--redetect` says so.
      const reinstallConfig = existsSync(L.config);
      for (const d of [L.aidlc, L.claude, path.join(L.aidlc, 'bin'), path.dirname(L.reviewPolicy), L.artifacts, L.state]) mkdirSync(d, { recursive: true });
      for (const [src, dst] of [['templates/harness.toml', L.config], ['templates/gitignore', path.join(L.aidlc, '.gitignore')]]) {
        if (!existsSync(dst)) cpSync(path.join(HERE, src), dst);
      }

      // The project's formatter must not be handed the harness's own generated files. See
      // GENERATED_PATHS for the delivery this cost. Append-only, and only in a project that has a
      // formatter to teach: creating `.prettierignore` where there is no prettier would be litter.
      if (!self && existsSync(path.join(root, 'package.json'))) {
        const ignore = path.join(root, '.prettierignore');
        const added = ignoreFileAdditions(existsSync(ignore) ? readFileSync(ignore, 'utf8') : '');
        if (added) {
          writeFileSync(ignore, added.next);
          console.error(`added ${added.missing.join(', ')} to .prettierignore — the harness generates them and your formatter would fail on them`);
        }
      }

      // G12. An empty verb is `skipped`, which is honest and completely silent: a project
      // installed the harness, ran `doctor`, saw nine dashes, and got a governance kernel with no
      // sensors attached to it. Filling them by hand was the step nobody did.
      //
      // Detection reads the project's own manifests, never this machine, and it only ever fills a
      // verb that is empty — a configured command is a decision, and re-running `init` must not
      // quietly undo it. `--no-detect` opts out; `--redetect` fills verbs left empty since.
      const detected = detect(root);
      if (!has('no-detect')) {
        const filled = applyDetection(readFileSync(L.config, 'utf8'), detected);
        if (filled.filled.length && (!reinstallConfig || has('redetect'))) {
          writeFileSync(L.config, filled.toml);
          console.error(`detected toolchain: filled ${filled.filled.join(', ')} in ${path.relative(root, L.config)}`);
        } else if (filled.filled.length) {
          console.error(`toolchain detected verbs this registry leaves empty (${filled.filled.join(', ')}); re-run with --redetect to fill them`);
        }
      }
      if (has('detect')) { console.log(detectionReport(detected, VERBS)); return 0; }

      // G17. `--ci` writes the consumer's own workflow: deterministic checks as the gate, an
      // independent review as one deduped comment, and branch protection as the merge gate. It is
      // written once and never overwritten — a CI file is a project's own, and a generator that
      // rewrote it would take that back on every install.
      if (has('ci')) {
        const workflow = path.join(root, '.github', 'workflows', 'harness.yml');
        if (existsSync(workflow) && !has('force')) console.error(`kept ${path.relative(root, workflow)} — it is yours; delete it and re-run with --ci to regenerate`);
        else {
          mkdirSync(path.dirname(workflow), { recursive: true });
          cpSync(path.join(HERE, 'templates', 'consumer-ci.yml'), workflow);
          console.error(`wrote ${path.relative(root, workflow)} — set CLAUDE_CODE_OAUTH_TOKEN in repository secrets, and require this check plus a code-owner review in branch protection`);
        }
      }
      // Whether this is an install or a re-run. On a first install the project's existing
      // CLAUDE.md is adopted as the canonical source and then re-rendered with the generated
      // header, so its content legitimately changes — that is installing, not invalidating.
      const reinstall = existsSync(L.instructions);
      if (!reinstall) {
        // Adopting replaces the template's `## Project conventions`; it does not replace the
        // template. See composeProjectInstructions for what was measured when it did.
        const adopted = existsSync(L.rootClaudeMd) ? readFileSync(L.rootClaudeMd, 'utf8')
          : existsSync(L.claudeMd) ? readFileSync(L.claudeMd, 'utf8')
          : null;
        const composed = composeProjectInstructions(
          readFileSync(path.join(HERE, 'templates', 'project-instructions.md'), 'utf8'), adopted);
        writeFileSync(L.instructions, composed);
        // Law 5's ceiling is measured on the projection, and a project whose own instructions are
        // long now crosses it at install time rather than at its first `--stage commit`.
        const ceiling = loadConfig(root).limits?.claude_md_lines;
        const projected = renderClaudeInstructions(composed).split('\n').length;
        if (adopted && ceiling && projected > ceiling) console.error(
          `.claude/CLAUDE.md will be ${projected} lines against [limits].claude_md_lines = ${ceiling}.`
          + ` Trim "## Project conventions" in .aidlc/instructions.md and re-run 'harness init --into . --force'.`);
      }
      if (!existsSync(L.reviewPolicy)) cpSync(path.join(HERE, 'policies', 'review.md'), L.reviewPolicy);

      // Regeneration changes steering inputs. Refuse unexpected rewrites on re-install;
      // an explicit operator decision can apply them. Root instruction changes need a reload.
      //
      // Compared by content, not by asking whether a session is running: an install that is
      // already current writes nothing and cannot trip this, which is what "safe to re-run" has
      // always meant. Collected before anything is written, so a refusal leaves the tree alone.
      const claudeMdNext = self
        ? selfInstructions()
        : renderClaudeInstructions(readFileSync(L.instructions, 'utf8'));
      const projectedInstructions = self
        ? [[L.claudeMd, claudeMdNext]]
        : [[L.claudeMd, claudeMdNext], [L.rootClaudeMd, claudeMdNext]];
      const wouldChange = (reinstall ? projectedInstructions : [])
        .filter(([file, next]) => existsSync(file) && readFileSync(file, 'utf8') !== next)
        .map(([file]) => path.relative(root, file));
      if (wouldChange.length && !has('force')) {
        console.error(`init would rewrite ${wouldChange.join(', ')}, which configures agent instructions or permissions.\nReview these changes and restart the session to load instruction changes.\nRe-run with --force, or make the change between sessions.`);
        return 1;
      }

      writeFileSync(L.claudeMd, claudeMdNext);
      if (!self) writeFileSync(L.rootClaudeMd, claudeMdNext);

      // lean-v2 B7. The generator/evaluator split is two model ids in [models], rendered into the
      // two files that carry it. Written here rather than by hand so the registry stays the one
      // place either id is stated.
      //
      // G10 widened it: `judgment` is the model that decides rather than types, and it is rendered
      // into the four skills that produce a human's gate material and into the evaluator's own
      // prompt. `[effort]` rides in the same frontmatter — one band for typing under an approved
      // plan, one for judging — so the registry stays the one place either is stated.
      try {
        if (path.resolve(L.aidlc) !== path.resolve(HERE)) throw new Error("consumer uses pinned shared guides");
        const { models, effort } = loadConfig(root);
        const skill = (name) => path.join(HERE, 'skills', name, 'SKILL.md');
        for (const [file, model, extra] of [
          [skill('implement'), models.generator, { context: 'fork', effort: effort.implement }],
          [skill('intent'), models.judgment, { effort: effort.review }],
          [skill('spec'), models.judgment, { effort: effort.review }],
          [skill('plan'), models.judgment, { effort: effort.review }],
          // `design` arrives with G16 and replaces `map`; rendering both here means the skill that
          // exists is the skill that gets the model, on either side of that change.
          [skill('design'), models.judgment, { effort: effort.review }],
          [skill('map'), models.judgment, { effort: effort.review }],
          [path.join(HERE, 'roles', 'evaluator.md'), models.judgment, { effort: effort.review }],
        ]) {
          if (!existsSync(file)) continue;
          const next = renderModel(readFileSync(file, 'utf8'), model, extra);
          if (next !== readFileSync(file, 'utf8')) writeFileSync(file, next);
        }
      } catch { /* a project without [models] keeps whatever the plugin shipped */ }
      // A project declares the harness; it never contains one. Copying the sensors in and
      // leaving the guides to a second, invisible install step is what produced projects that
      // ran every check with no guide loaded and no way to notice.
      const identity = pluginIdentity();
      writeFileSync(path.join(L.claude, 'settings.json'),
        JSON.stringify(self ? selfSettings(identity.id) : projectSettings(identity.id), null, 2) + '\n');

      if (!self) {
        // An install made by an older harness carries .claude/runtime/ — the copy of the harness
        // this change exists to remove. Upgrading by re-running `init` must not leave it sitting
        // there: a stale copy is exactly the drift the pod is meant to be protected from, and it
        // is the more dangerous kind, because it looks installed.
        rmSync(path.join(L.claude, 'runtime'), { recursive: true, force: true });
        // The guides live in the plugin, so the project cannot count them and CI cannot fetch
        // them without being told where from. One committed record answers both, and pins the
        // exact commit so CI never drifts from the laptop that installed it.
        const installedIdentity = installationIdentity(PLUGIN_ROOT);
        if (installedIdentity.status !== 'verified') console.error('runtime identity unverified: install from a clean Git checkout before using the consumer shim.');
        writeFileSync(path.join(L.aidlc, RECORD), JSON.stringify({
          note: `generated by 'harness init' — do not edit by hand; re-run init to refresh`,
          marketplace: identity.name,
          plugin: identity.name,
          version: identity.version,
          commit: harnessCommit(),
          identity: installedIdentity,
          repository: harnessRepository(),
          shipped: shipped(PLUGIN_ROOT),
        }, null, 2) + '\n');
        const shim = path.join(L.aidlc, 'bin', 'harness');
        writeFileSync(shim, shimSource());
        chmodSync(shim, 0o755);
      }
      const how = self ? 'node .aidlc/bin/harness' : '.aidlc/bin/harness';
      console.log(`initialised .aidlc/ in ${root}\n  1. edit .aidlc/harness.toml — capability verbs, one command each\n  2. ${how} doctor\n  3. ${how} baseline capture\n  provider guides come from adapters such as the ${identity.id} plugin`);
      return 0;
    }

    case 'doctor': {
      const cfg = loadConfig(findRepoRoot());
      const identity = { runtime: runtimeIdentity(cfg.layout.root), policy: policyIdentity(cfg.layout.root) };
      const identityOK = ['verified', 'development'].includes(identity.runtime.status) && identity.policy.digest !== null;
      if (has('json')) { console.log(JSON.stringify(identity, null, 2)); return identityOK ? 0 : 1; }
      console.log(`runtime   ${identity.runtime.status} (${identity.runtime.method}) expected=${identity.runtime.expected?.commit ?? 'none'} observed=${identity.runtime.observed?.commit ?? 'unknown'} content=${identity.runtime.observed?.content?.digest ?? 'unknown'}\npolicy    ${identity.policy.digest ?? 'unavailable'} (${identity.policy.state})`);
      console.log('coverage  ' + RUNTIME_PATHS.join(', '));
      console.log('policy inputs  ' + (identity.policy.entries ?? []).map(e => e.path + (e.digest ? '' : ' (absent)')).join(', '));
      if (identity.runtime.remedy) console.log(identity.runtime.remedy);
      console.log(`project   ${cfg.project.name ?? '(unnamed)'}\nroot      ${cfg.layout.root}\n`);
      for (const v of VERBS) {
        const c = cfg.capabilities[v];
        const fmt = cfg.formats[v] ?? 'generic';
        const builtin = v === 'secrets' && !c;
        console.log(`  ${c || builtin ? 'set ' : '--  '} ${v.padEnd(10)} ${c ? `[${fmt}] ${c}` : builtin ? '[built-in] secret scanner' : '(skipped — no command)'}`);
      }
      const m = measure(cfg);
      // `?`, never `0`: a surface the budget could not account for must not read as an empty one.
      console.log(`\nbudget    ${Object.entries(m).map(([k, v]) => `${k}=${v ?? '?'}/${cfg.limits[k] ?? '-'}`).join('  ')}`);
      const market = path.join(cfg.layout.root, '.claude-plugin/marketplace.json');
      let selfPlugin = null;
      if (existsSync(market)) {
        try {
          const plugins = JSON.parse(readFileSync(market, 'utf8')).plugins ?? [];
          selfPlugin = plugins[0]?.name ?? null;
          console.log(`plugins   ${plugins.map((p) => p.name).join(', ') || '(none)'}`);
        } catch { /* marketplace is advisory */ }
      }
      // G05. An agent is selected by name, so a second installed plugin defining `evaluator` is a
      // run that can obtain its independent review from a different harness and say nothing about
      // it. Reported, never refused: which plugins an operator keeps is their decision, and this
      // repository does not legislate for the rest of their machine.
      try {
        console.log(collisionLines(collisions({ rolesDir: path.join(HERE, 'roles'), self: selfPlugin })).join('\n'));
      } catch { /* a diagnostic that cannot read the plugin cache reports nothing, not an error */ }
      return identityOK ? 0 : 1;
    }

    case 'check': {
      const cfg = loadConfig(findRepoRoot());
      const stage = flag('stage', 'fast');
      if (argv.some(arg => /^--(base|candidate|change|pr-event)=/.test(arg))) throw new Error('use --base <ref>, --candidate <ref>, --change <slug> or --pr-event <file> with separate values');
      const files = has('changed') ? changedFiles(cfg.layout.root) : (flag('files') && typeof flag('files') === 'string' ? String(flag('files')).split(',') : []);
      for (const option of ['base', 'candidate', 'change', 'pr-event']) {
        if (argv.filter(arg => arg === `--${option}`).length > 1) throw new Error(`duplicate --${option}`);
      }
      if (has('pr-event') && has('change')) throw new Error('use --change or --pr-event, not both');
      const change = has('pr-event')
        ? prChange(JSON.parse(readFileSync(flag('pr-event'), 'utf8')).pull_request?.body)
        : has('change') ? flag('change') : undefined;
      if (argv.filter(arg => arg === '--actor').length > 1) throw new Error('duplicate --actor');
      const report = await check(cfg, { stage, files, all: has('all'), change,
        ...(has('actor') ? { actor: flag('actor') } : {}),
        ...(has('base') ? { base: flag('base') } : {}),
        ...(has('candidate') ? { candidate: flag('candidate') } : {}),
      });
      if (has('json')) console.log(JSON.stringify(report, null, 2));
      else console.log(render(report, cfg.layout));
      return report.ok ? 0 : 1;
    }

    case 'evals': {
      if (argv[1] !== 'gate') { console.error('usage: harness evals gate [--update]'); return 2; }
      const root = findRepoRoot(); const L = layout(root);
      const recordFile = path.join(root, 'evals', 'expected.json');
      let record;
      try { record = evalGate.readRecord(recordFile); } catch (e) { console.error(String(e.message)); return 2; }
      // The record first, so "a full run" means "graded everything the record expects" rather than
      // "has more ids than anything else on disk". Without the ids, one historical run that also
      // carried two product tasks outranked every golden run after it forever, and the gate went on
      // grading 2026-09-04 while today's complete run sat in the same directory.
      const results = evalGate.loadResults(path.join(L.aidlc, 'evals', 'results'), new Set(Object.keys(record.tasks ?? {})));

      if (has('update')) {
        if (!results) { console.error('no eval results to record — run `node evals/run.mjs` first'); return 1; }
        let next;
        try { next = evalGate.update(record, results, { commit: gitHead(root) }); }
        catch (e) { console.error(String(e.message)); return 1; }
        evalGate.writeRecord(recordFile, next);
        const priced = Object.values(next.tasks).filter((t) => t?.usd != null).length;
        const total = next.usd_total != null ? `, suite floor ${next.usd_total.toFixed(2)}` : '';
        const from = next.sources?.length > 1 ? `${next.sources.length} runs: ${next.sources.join(', ')}` : next.source;
        console.log(`${recordFile}\n${Object.keys(next.tasks).length} tasks recorded from ${from}${priced ? `, ${priced} with a cost floor` : ''}${total}`);
        return 0;
      }

      const result = evalGate.gate(results, record);
      for (const line of evalGate.render(result)) console.log(line);
      return result.ok ? 0 : 1;
    }

    case 'ledger': {
      const root = findRepoRoot(); const L = layout(root);
      if (argv[1] === 'export') {
        if (argv.length !== 4 || argv[2] !== '--invocation') throw new Error('usage: harness ledger export --invocation <id>');
        console.log(JSON.stringify(ledger.exportInvocation(L, argv[3]), null, 2)); return 0;
      }
      // The audit cannot judge a control no stage runs, so tell it which ones a stage reaches.
      let staged = null; let deterrents = null;
      try { const cfg = loadConfig(root); staged = ledger.wiredControls(cfg); deterrents = cfg.deterrents; } catch { /* no config: judge everything */ }
      const days = Number(flag('days', 30));
      if (argv[1] === 'audit') {
        const a = ledger.audit(L, { days, staged, deterrents, root });
        for (const w of a.warnings) console.error(`warning: ${w}`);
        console.log(`ledger audit · ${a.rows} rows · ${a.runs} runs · last ${a.days}d`);
        console.log(`thresholds: fires on >=${a.thresholds.min_fire_rate * 100}% of invocations, errors on <${a.thresholds.max_error_rate * 100}%, after ${a.thresholds.min_sessions} invocations\n`);
        for (const c of a.controls) {
          console.log(`  ${c.control.padEnd(16)} ${String(c.invocations).padStart(3)} inv  ${(c.fire_rate * 100).toFixed(1).padStart(5)}% fired  ${c.action}`);
          // B9: a fire rate says how busy a control is; only the per-rule split says whether
          // being busy was useful.
          for (const rule of c.rules ?? []) {
            const flagged = rule.false ? `  ${rule.false} called false` : '';
            console.log(`      ${rule.rule.padEnd(22)} ${String(rule.fired).padStart(3)} fired${flagged}${rule.noisy ? '  NOISY — fix the rule or delete it' : ''}`);
          }
        }
        console.log(a.deletions.length ? `\nDelete: ${a.deletions.join(', ')}` : '\nNothing the ledger can justify deleting on its own evidence.');
        if (a.decide.length) console.log(`Decide:  ${a.decide.join(', ')} — read each why: before acting`);
        if (a.noisy.length) console.log(`Noisy:   ${a.noisy.join(', ')} — more than half of these fires were called false`);
        if (a.retired.length) console.log(`Retired: ${a.retired.join(', ')} — nothing reaches these and nothing has recorded them for a week`);
        return 0;
      }
      // B9. The human's half of the record. A guard that blocked work it should not have is
      // invisible to a ledger that only counts fires, and OPERATING.md's weekly question — "did
      // anything block you that should not have" — had no data source at all before this.
      if (argv[1] === 'flag') {
        const rule = argv[2];
        if (!rule) { console.error('usage: harness ledger flag <rule> [--run <id>] [--false]'); return 2; }
        const marked = ledger.flag(L, { rule, run: flag('run'), value: !has('true') });
        console.log(marked ? `flagged ${marked} row(s) of ${rule}` : `no unflagged ${rule} rows found`);
        return marked ? 0 : 1;
      }
      const r = ledger.report(L, { days, staged });
      if (has('json')) { console.log(JSON.stringify(r, null, 2)); return 0; }
      console.log(`ledger  ${r.rows} rows  ${r.runs} runs  last ${r.days}d\n`);
      console.log('  control      invocations  fired   fire%   errs  avg-ms  verdict');
      for (const c of r.controls) console.log(`  ${c.control.padEnd(12)} ${String(c.invocations).padStart(11)} ${String(c.fired).padStart(6)} ${(c.fire_rate * 100).toFixed(1).padStart(7)} ${String(c.errored).padStart(6)} ${String(c.avg_ms).padStart(7)}  ${c.verdict}`);
      return 0;
    }

    case 'baseline': {
      const cfg = loadConfig(findRepoRoot());
      const sub = argv[1];
      const now = await baseline.capture(cfg);
      if (sub === 'capture') { console.log(`baseline captured: ${baseline.save(cfg, now)}`); return 0; }
      if (sub !== 'check') { console.error('usage: harness baseline capture|check'); return 2; }
      const base = baseline.load(cfg);
      if (!base) { console.error('no baseline — run: harness baseline capture'); return 2; }
      const result = baseline.compare(base, now);
      for (const r of result.rows) console.log(`${r.regressed ? 'FAIL' : r.skipped ? 'SKIP' : 'PASS'}  ${r.metric.padEnd(24)} ${r.was} -> ${r.is}${r.skipped ? `  (${r.skipped})` : ''}`);
      return result.ok ? 0 : 1;
    }

    case 'graph': {
      const cfg = loadConfig(findRepoRoot());
      const sub = argv[1];
      if (sub === 'build') { const g = graph.build(cfg); graph.save(cfg, g); console.log(`graph built: ${Object.keys(g.modules).length} modules`); return 0; }
      if (sub === 'refresh') { console.log(JSON.stringify(refresh(cfg, { force: has('force') }), null, 2)); return 0; }
      if (sub === 'query') {
        const question = argv[2]; const arg = argv[3];
        if (question === 'product') {
          const options = contextOptions(argv.slice(3));
          const view = productContext(cfg, options);
          console.log(options.json ? JSON.stringify(view, null, 2) : renderProduct(view));
          return view.unavailable ? 1 : 0;
        }
        const g = graph.ensure(cfg);
        console.log(renderGraphAnswer(question, arg, graph.query(g, question, arg, { root: cfg.layout.root })));
        return 0;
      }
      console.error('usage: harness graph build|refresh|query <callers|calls|hubs|cycles|changed-since> [arg]'); return 2;
    }

    // B11. One generated page, so a session reads a ranked map instead of grepping for structure.
    case 'map': {
      const cfg = loadConfig(findRepoRoot());
      const g = graph.ensure(cfg);
      if (has('check')) {
        const d = codemap.drift(cfg, g);
        if (!d.drifted) { console.log(`PASS  ${codemap.MAP_FILE} matches the tree`); return 0; }
        console.error(`FAIL  ${d.reason}${d.gone?.length ? `\n  gone:  ${d.gone.join(', ')}` : ''}${d.added?.length ? `\n  added: ${d.added.join(', ')}` : ''}\n  run: harness map`);
        return 1;
      }
      const r = codemap.write(cfg, g);
      console.log(`${path.relative(cfg.layout.root, r.file)}  ${r.lines} lines, ${Object.keys(g.modules).length} modules`);
      return 0;
    }

    case 'pack': {
      const cfg = loadConfig(findRepoRoot());
      if (has('revision') || has('records')) {
        const question = argv[1];
        if (!question || question.startsWith('--')) throw new Error('pack requires a symbol or path before revision options');
        const options = contextOptions(argv.slice(2), true);
        const result = revisionPack(cfg, question, options);
        console.log(options.json ? JSON.stringify(result, null, 2) : renderRevisionPack(result));
        return result.product_unavailable || result.unavailable ? 1 : 0;
      }
      const question = argv.slice(1).filter((x) => x !== '--budget' && x !== String(flag('budget'))).join(' ');
      console.log(renderPack(pack(cfg, graph.ensure(cfg), question, { budget: Number(flag('budget', 1200)) })));
      return 0;
    }

    case 'new': {
      const slug = argv[1];
      if (!slug && !has('from')) { console.error('usage: harness new <slug>   |   harness new [<slug>] --from <path.md | https-url> [--split]   |   harness new eval <slug>'); return 2; }
      const cfg = loadConfig(findRepoRoot());

      // An eval is not a change; it is a regression the suite keeps. Kept on this verb because
      // "the incident becomes a permanent eval" is a step of the same loop.
      if (slug === 'eval') {
        const id = argv[2];
        if (!validSlug(id)) { console.error('usage: harness new eval <slug>'); return 2; }
        const dir = path.join(cfg.layout.aidlc, 'evals', 'pending'); mkdirSync(dir, { recursive: true });
        const dst = path.join(dir, `${id}.json`);
        if (existsSync(dst)) { console.log(dst); return 0; }
        writeFileSync(dst, JSON.stringify({ id, fixture: 'clean-app', prompt: `Regression for ${id}. Reproduce, then keep the suite green without editing the failing test.`, assert: [{ fixture_tests_pass: true }, { files_unchanged: ['README.md'] }] }, null, 2) + '\n');
        console.log(dst); return 0;
      }

      // G08: intake from a document. The kernel reads a path or takes a URL string; a tracker
      // read is the agent's job, written to a file and passed here as a path. No tracker client,
      // no credential and no network call enters the kernel.
      if (has('from')) {
        const from = flag('from');
        if (typeof from !== 'string' || !from) { console.error('usage: harness new [<slug>] --from <path.md | https-url> [--split] [--revision <id>]'); return 2; }
        const named = slug && !slug.startsWith('--') ? slug : null;
        if (named && !validSlug(named)) { console.error('slug must be 1-63 lowercase letters, digits, or hyphens; it cannot contain paths'); return 2; }
        try {
          const decision = intake.plan(cfg, { from, slug: named, split: has('split'), revision: has('revision') ? flag('revision') : null });
          for (const written of intake.write(cfg, decision, path.join(HERE, 'templates'))) {
            console.log(`${written}  ${path.relative(cfg.layout.root, artifacts.dir(cfg, written))}`);
          }
          if (decision.split) {
            console.log(`\ninitiative "${decision.parent}" decomposed into ${decision.changes.length} change(s)`);
            for (const c of decision.changes) if (c.dependsOn.length) console.log(`  ${c.slug} depends_on ${c.dependsOn.join(', ')}`);
            console.log('  harness status   # the decomposition, its parent grouping and its dependency edges');
          }
          if (decision.note) console.log(`\nnote: ${decision.note}`);
          // A stated order the tool could not resolve is reported, never dropped: an order
          // silently ignored is worse than no order at all.
          for (const finding of decision.findings) console.log(`  UNRESOLVED ${finding}`);
          return 0;
        } catch (error) { console.error(error.message); return 1; }
      }

      if (!validSlug(slug)) { console.error('slug must be 1-63 lowercase letters, digits, or hyphens; it cannot contain paths'); return 2; }
      try {
        for (const written of artifacts.create(cfg, slug, path.join(HERE, 'templates'))) console.log(written);
        return 0;
      } catch (error) { console.error(error.message); return 1; }
    }

    // The one approval verb. It replaced `contract accept`, two `contract seal --scope` calls and
    // `contract evidence`: four commands, and because each seal demanded a commit before the next
    // was allowed, four commits for one human decision.
    case 'approve': {
      const cfg = loadConfig(findRepoRoot());
      const slug = argv[1]; const kind = argv[2];
      const by = flag('by', process.env.HARNESS_ACTOR);
      // B4: `--anyway` with no value at all (boolean flag()) becomes '', not null, so
      // artifacts.approve() sees an empty reason and refuses it rather than silently ignoring it.
      const anyway = has('anyway') ? (typeof flag('anyway') === 'string' ? flag('anyway') : '') : null;
      if (!validSlug(slug) || !artifacts.GATED.includes(kind)) { console.error(`usage: harness approve <slug> ${artifacts.GATED.join('|')} --by <identity> [--anyway <reason>] [--policy]`); return 2; }
      try {
        // G06 `auto`: the driver records the approval the configuration already gave. Refused by
        // artifacts.approve() in every other mode, and still refused to the agent's own shell by
        // the `approve-is-the-humans` hook rule — the driver reaches this through the library.
        const result = artifacts.approve(cfg, slug, kind, { by: typeof by === 'string' ? by : null, anyway, policy: has('policy') });
        console.log(`${kind} approved  ${result.digest}\n${path.relative(cfg.layout.root, result.file)}\ncommit this approval before continuing`);
        return 0;
      } catch (error) { console.error(error.message); return 1; }
    }

    // G18. The release record: which commit a human authorised for a live environment, by whom,
    // and until when. `approve-is-the-humans` refuses this command to the agent's own shell, the
    // same way it refuses a gate approval — a record the agent can write is worth what the
    // environment variable it replaced was worth.
    case 'release': {
      const cfg = loadConfig(findRepoRoot());
      const sub = argv[1];
      if (sub === 'approve') {
        try {
          const record = release.approve(cfg, { by: flag('by'), minutes: Number(flag('minutes', release.DEFAULT_MINUTES)) });
          console.log(`release approved  ${record.candidate.slice(0, 12)}\n  by ${record.approved_by}, expires ${record.expires}\n  ${path.relative(cfg.layout.root, release.file(cfg))}`);
          ledger.append({ stage: 'release', control: 'release-record', verdict: 'pass', ms: 0, findings: 0,
            candidate: record.candidate, approved_by: record.approved_by, reason: `approved until ${record.expires}` }, cfg.layout);
          return 0;
        } catch (error) { console.error(error.message); return 1; }
      }
      if (sub === 'revoke') {
        const { revoked } = release.revoke(cfg);
        console.log(revoked ? 'release record revoked' : 'no release record to revoke');
        if (revoked) ledger.append({ stage: 'release', control: 'release-record', verdict: 'pass', ms: 0, findings: 0, reason: 'revoked' }, cfg.layout);
        return 0;
      }
      if (sub === 'status' || sub === undefined) {
        const current = release.state(cfg);
        console.log(JSON.stringify(current, null, 2));
        return current.allowed ? 0 : 1;
      }
      console.error('usage: harness release approve --by <identity> [--minutes 60] | revoke | status');
      return 2;
    }

    case 'review': {
      const cfg = loadConfig(findRepoRoot());
      if (has('pr') || has('repo')) {
        const result = hostReview({ root: cfg.layout.root, repository: flag('repo'), pr: flag('pr'),
          candidate: flag('candidate'), output: flag('out') });
        console.log(JSON.stringify(result, null, 2));
        return result.verified ? 0 : 1;
      }
      // G17. The headless path: structured findings, deduped against what the harness already said
      // on this pull request, posted as one comment. It posts a comment and nothing else — no
      // review, no approval, no status check. Branch protection and a code-owner review are the
      // merge gate, and a machine that could satisfy that gate would not be a gate.
      if (has('comment')) {
        const repo = flag('repo');
        const pr = flag('pr');
        if (!repo || !pr) { console.error('usage: harness review --comment --repo <owner/name> --pr <number> --base <ref> --candidate <ref>'); return 2; }
        const out = flag('out', '.aidlc/state/review-findings.json');
        const result = review({ root: cfg.layout.root, base: flag('base'), candidate: flag('candidate'),
          output: out, model: cfg.models?.evaluator, budgetUsd: Number(flag('budget-usd', 2)),
          timeoutMs: has('timeout') ? Number(flag('timeout')) : null,
          schema: prReview.reviewSchema(), fullTree: has('full-tree') });
        if (result.status === 'incomplete') {
          console.error(`review incomplete (${result.reason}); no comment posted — a partial review is not a review`);
          return 1;
        }
        const report = readFileSync(path.resolve(cfg.layout.root, out), 'utf8');
        const parsed = prReview.parseFindings(report.slice(report.indexOf('{')));
        const comments = prReview.ghComments({ repo, pr, run: spawnSync });
        const { fresh, repeated } = prReview.dedupeFindings(parsed.findings, comments);
        if (!prReview.shouldComment({ fresh, repeated, comments })) {
          console.log(JSON.stringify({ posted: false, fresh: 0, repeated: repeated.length, verdict: parsed.verdict }, null, 2));
          return 0;
        }
        const body = prReview.renderReviewComment({ findings: fresh, repeated, verdict: parsed.verdict,
          limitations: parsed.limitations, base: result.base, candidate: result.candidate, model: cfg.models?.evaluator });
        const url = prReview.postComment({ repo, pr, body, run: spawnSync });
        console.log(JSON.stringify({ posted: true, url, fresh: fresh.length, repeated: repeated.length, verdict: parsed.verdict }, null, 2));
        return 0;
      }

      // G02: the reviewer reads the change's neighbourhood. The plan's `## Files` is the scope, the
      // graph supplies the importers, and the change's own artifacts come along because compliance
      // is judged against them. `--full-tree` opts out; an unselected or unapproved change has no
      // scope to apply and falls back to the whole tree on its own.
      const current = artifacts.currentChange(cfg);
      const planFiles = has('full-tree') ? [] : current?.plan?.owns ?? [];
      const result = review({ root: cfg.layout.root, base: flag('base'), candidate: flag('candidate'),
        output: flag('out'), model: cfg.models?.evaluator, budgetUsd: Number(flag('budget-usd', 2)),
        timeoutMs: has('timeout') ? Number(flag('timeout')) : null,
        planFiles, contextPaths: planFiles.length ? [path.join(path.relative(cfg.layout.root, cfg.layout.artifacts), current.slug)] : [],
        modules: planFiles.length ? graph.load(cfg)?.modules ?? null : null, fullTree: has('full-tree') });
      console.log(JSON.stringify(result, null, 2));
      return result.status === 'incomplete' ? 1 : 0;
    }

    // G09. The seven phases between the plan approval and the merge decision. Law 2 keeps the
    // sequencing in the library this case calls, never in a skill.
    case 'deliver': {
      const cfg = loadConfig(findRepoRoot());
      const slug = argv[1] && !argv[1].startsWith('--') ? argv[1] : artifacts.currentChange(cfg)?.slug;
      if (!slug) { console.error('usage: harness deliver <slug> --live [--dry] [--actor <label>]\n  no slug given and no change is selected (harness status --change <slug>)'); return 2; }
      if (has('status')) { const state = readState(cfg, slug); console.log(JSON.stringify(state ?? { slug, state: 'no run recorded' }, null, 2)); return state ? 0 : 1; }
      const result = await deliver(cfg, slug, {
        invoke: deliverInvoker({ root: cfg.layout.root, pluginDir: PLUGIN_ROOT }),
        openPr: ghPullRequest({ root: cfg.layout.root }),
        live: has('live'), dry: has('dry'),
        ...(has('actor') ? { actor: flag('actor') } : {}),
        log: (line) => console.error(line),
      });
      console.log(JSON.stringify(result, null, 2));
      return result.ok || result.dry ? 0 : 1;
    }

    // G25. The playbook's own numbers, from evidence this harness already writes: the ledger, the
    // artifact chain, the driver's phase records, the eval evidence. Its own verb rather than a
    // `ledger` subcommand — `ledger-evidence-not-reporting` froze that surface against a reporting
    // service and was right to, and most of what this reads is not the ledger anyway. It reads and
    // prints; it writes nothing and publishes nothing.
    case 'metrics': {
      const cfg = loadConfig(findRepoRoot());
      const m = metrics(cfg, { days: Number(flag('days', 30)) });
      console.log(has('json') ? JSON.stringify(m, null, 2) : renderMetrics(m));
      return 0;
    }

    case 'status': {
      const cfg = loadConfig(findRepoRoot());
      if (has('change') && has('clear-change')) throw new Error('use --change <slug> or --clear-change, not both');
      if (has('change')) artifacts.selectChange(cfg, flag('change'));
      if (has('clear-change')) artifacts.clearSelection(cfg);

      const requested = argv[1] && !argv[1].startsWith('--') ? argv[1] : null;
      const all = (requested ? [requested] : artifacts.slugs(cfg)).map((slug) => artifacts.state(cfg, slug));
      // Closed changes are history. `--all` when you want the history.
      const rows = requested || has('all') ? all : all.filter((r) => !r.closed);
      const hidden = all.length - rows.length;
      // B4: a reader can tell a behaviour was superseded without reading every change that came
      // after it. Computed from every approved spec's `supersedes:` link, not filtered by
      // `--all` — the superseded spec's own row can be closed while the fact still matters.
      const superseded = [...artifacts.supersededBy(cfg)];
      const selected = artifacts.selectionState(cfg);
      const team = coordination(cfg, { change: requested ?? (selected.ok ? selected.slug : null) });
      if (has('json')) { console.log(JSON.stringify({ current: artifacts.currentChange(cfg), selection: artifacts.selectionState(cfg), changes: rows, coordination: team, superseded: Object.fromEntries(superseded), supersession_meaning: 'approved/proposed declarations, not delivered truth; use graph query product --revision <ref>' }, null, 2)); return rows.some((r) => !r.ok) ? 1 : 0; }
      console.log(artifacts.currentLine(cfg));
      console.log(coordinationLines(team).join('\n'));
      if (superseded.length) console.log('Delivery context: harness graph query product --revision <ref>');
      if (!rows.length) {
        console.log(`changes  none open${hidden ? `  (${hidden} closed; --all to list)` : ''}`);
        for (const [link, by] of superseded) console.log(`  APPROVED/PROPOSED SUPERSESSION ${link} — declared by ${by.join(', ')}`);
        return 0;
      }
      // a-diff-belongs-to-one-change B6: which change a product write belongs to right now, and
      // whether it can permit one. Same wording as the SessionStart line, from one function.
      console.log('changes\n\n  change                         next                 spec       plan');
      for (const row of rows) {
        const mark = (kind) => row.artifacts[kind]?.state ?? 'absent';
        console.log(`  ${row.slug.padEnd(30)} ${row.next.padEnd(20)} ${mark('spec').padEnd(10)} ${mark('plan')}`);
        console.log(`    binding: spec ${row.artifacts.spec?.binding ?? 'absent'}, plan ${row.artifacts.plan?.binding ?? 'absent'}`);
        for (const kind of artifacts.GATED) if (row.artifacts[kind]?.bindingError) console.log(`    ${kind}: ${row.artifacts[kind].bindingError}`);
      }
      for (const row of rows) for (const issue of row.issues) console.log(`  ERROR ${row.slug}: ${issue}`);
      // G06: an advisory gate is a row, never an error exit. It is printed after the errors so a
      // reader who has one of each still sees the blocking one last-but-one, and `ok` above is
      // computed from the blocking half only — this loop cannot change the exit code.
      for (const row of rows) for (const advisory of row.advisories ?? []) console.log(`  ADVISORY ${row.slug}: ${advisory}`);
      for (const [link, by] of superseded) console.log(`  APPROVED/PROPOSED SUPERSESSION ${link} — declared by ${by.join(', ')}`);
      if (hidden) console.log(`\n  ${hidden} closed change(s) not listed; --all to see them`);
      return rows.some((r) => !r.ok) ? 1 : 0;
    }

    case 'hook': return dispatch(argv[1]);

    default:
      console.log(`harness — the lean SDLC harness

  harness init [--into DIR]        create .aidlc/ plus selected provider projections
    [--detect]                     print what the toolchain detector sees, and exit
    [--redetect] [--no-detect]     fill verbs left empty since install / skip detection
    [--ci]                         write .github/workflows/harness.yml for this project
  harness doctor                   capability verbs and budget
  harness check --stage <s>        run a stage   (--changed  --all  --json)
    --base <ref> --candidate <ref>  check the full candidate diff (candidate must be HEAD)
    --change <slug> | --pr-event <file>  candidate-only selection; leaves local binding intact
  harness new <slug>               intent.md, spec.md, plan.md, review.md for one change
  harness new [<slug>] --from <path.md | https-url> [--split] [--revision <id>]
                                   intake a PRD or tracker story; --split writes one child
                                   change per "## Story" or acceptance-criteria group
  harness approve <slug> spec|plan --by <identity> [--policy]
  harness release approve --by <identity> [--minutes 60] | revoke | status
                                   authorise HEAD for a live environment, for a while
  harness review --base <commit> --candidate <commit> --out <file>
                                 independent read-only model review
    [--timeout <ms>]             default: 300 s + 2 s per KB of diff, capped at 900 s
    [--full-tree]                export the whole candidate, not the plan's neighbourhood
  harness review --repo owner/name --pr <number> --candidate <commit> --out <file>
                                 read-only GitHub approval evidence (JSON)
  harness review --comment --repo owner/name --pr <n> --base <ref> --candidate <ref>
                                 headless review posted as one deduped PR comment
  harness deliver <slug> --live    implement, check, refactor, review, repair, check, PR
    [--dry]                        print the phases, models and bounds; spend nothing
    [--status]                     print the recorded phases of an interrupted run
  harness status [slug] [--json]  backlog, selection and approvals
    --change <slug> | --clear-change  select execution in this worktree (never approves)
  harness ledger [audit] [--days 30]
  harness metrics [--days 30] [--json]
                                   first-pass checks, rework, lead time, escaped defects
  harness evals gate [--update]    grade the newest run against evals/expected.json
  harness baseline capture|check
  harness map [--check]            write CODEBASE-MAP.md, or fail if it is stale
  harness graph build|refresh|query <question> [arg]
  harness pack <question>          budgeted graph context
  harness hook <event>             hook dispatch (stdin/stdout JSON)`);
      return cmd ? 2 : 0;
  }
}

main().then((c) => { process.exitCode = c ?? 0; }).catch((e) => {
  if (e.code === 'ENOCONFIG') { console.error(e.message); process.exitCode = 2; return; }
  console.error(`harness: ${e.message}`);
  process.exitCode = 2;
});
