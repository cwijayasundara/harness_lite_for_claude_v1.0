{
  "description": "Generated Claude adapter projection of .aidlc/hooks/policy.json.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.aidlc/bin/harness\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.aidlc/bin/harness\" hook pre-tool",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit|MultiEdit|Bash|Grep|Glob"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.aidlc/bin/harness\" hook post-write",
            "timeout": 120
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.aidlc/bin/harness\" hook stop",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
