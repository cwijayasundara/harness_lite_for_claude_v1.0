.DS_Store

# Never a key in the tree. The commit stage's secret scanner catches `sk-ant-` in a tracked file,
# but a scanner is the second line: the first is that the file was never trackable. CI reads the
# key from a repository secret, not from here.
.env
.env.*
!.env.example
.claude/worktrees/

# Private product-trial snapshots and complete transcripts remain local evidence.
